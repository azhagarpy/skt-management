# ---- Application ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgres://payroll:payroll@localhost:5432/payroll
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Authentication ----
JWT_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret-at-least-32-characters
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_IN=30m
BCRYPT_ROUNDS=12

# ---- Storage (local disk by default, S3-compatible optional) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_UPLOAD_SIZE_MB=10

# ---- Optional infrastructure ----
REDIS_URL=

# ---- Seeding (development only) ----
SEED_DEFAULT_PASSWORD=Passw0rd!123

# WhatsApp notifications.
# `log` records messages without sending them - no account needed.
# Switch to `meta` and fill in the two credentials to deliver for real.
WHATSAPP_DRIVER=log
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Approved template with a document header, used to send a payslip PDF.
WHATSAPP_PAYSLIP_TEMPLATE_NAME=skt_payslip_document
WHATSAPP_PAYSLIP_TEMPLATE_LANGUAGE=en
