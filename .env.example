# Frontend build configuration. Copy to .env only if you need to override.
# The API is configured separately in server/.env.

# Where the browser sends API calls.
# Leave unset in development: vite.config.ts proxies /api to the API process,
# which keeps the app on one origin so the refresh cookie works.
# Set this only when the API is served from a different origin in production.
# VITE_API_URL=/api/v1
